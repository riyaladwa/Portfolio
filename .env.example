# ==============================================================================
# Portfolio Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in your deployment dashboard (Vercel / Render / etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration (Optional but Recommended)
# ------------------------------------------------------------------------------
# Connection string from your MongoDB Atlas cluster.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_URI=

# ------------------------------------------------------------------------------
# 2. Portfolio Owner & Email Recipient
# ------------------------------------------------------------------------------
# Recipient email address where contact form submissions will be delivered.
EMAIL_TO=riyaladwa9@gmail.com

# ------------------------------------------------------------------------------
# 3. Email Provider Option A: Nodemailer with Gmail SMTP
# ------------------------------------------------------------------------------
# Sender Gmail address
EMAIL_USER=riyaladwa9@gmail.com
# Google App Password (16 characters, generated in Google Account Security > 2-Step Verification > App passwords)
EMAIL_PASS=

# ------------------------------------------------------------------------------
# 4. Email Provider Option B: Resend (Alternative Serverless API)
# ------------------------------------------------------------------------------
# Resend API key (from resend.com/api-keys). If provided, Resend HTTP API is used.
RESEND_API_KEY=
# Verified domain sender address (e.g., 'Portfolio Contact <contact@riyaladwa.dev>' or 'onboarding@resend.dev')
RESEND_FROM=
EMAIL_FROM=
